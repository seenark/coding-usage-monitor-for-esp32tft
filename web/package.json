{
  "name": "web",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "lucide-react": "^1.41.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run --filter web dev",
    "dev:mock": "bun scripts/dev-mock.ts",
    "mock": "bun scripts/mock-api.ts",
    "build": "vp run -r build",
    "typecheck": "tsc --noEmit && vp run -r check-types",
    "test": "vp run --filter web test",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "catalog:",
    "@web/config": "workspace:*",
    "rolldown": "1.2.7",
    "typescript": "catalog:",
    "vite-plus": "0.3.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "packageManager": "bun@1.3.14"
}
