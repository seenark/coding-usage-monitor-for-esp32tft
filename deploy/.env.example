# Paths resolve relative to deploy/compose.yaml, not the current directory.
STATE_DIR=./state
HOST_UID=1000
HOST_GID=1000
# Set the host's actual LAN address for physical devices. Never use 0.0.0.0.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_HOST_PORT=1883
CODEX_ENABLED=true
# Private Claude endpoint is unsupported and may change. Opt in explicitly.
CLAUDE_PRIVATE_USAGE_ENABLED=false
# Admin app (web UI + API). No login: use loopback or a private LAN address, never 0.0.0.0.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8080
# Defaults for Server settings; settings.json written by the Admin app overrides them.
# Refresh interval per provider, 60..3600 seconds. MAX_BACKOFF_SECONDS must be >= both.
CLAUDE_POLL_INTERVAL_SECONDS=600
CODEX_POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=12
STALE_AFTER_SECONDS=900
MAX_BACKOFF_SECONDS=1800
